# Optional: API key for LLM transcription cleanup mode (Right Command hold/release).
# If no key is set, the cleanup hotkey will perform a standard plain paste without calling an LLM.

# Choose one of the following providers:
OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# GROQ_API_KEY=your_groq_api_key_here

# Optional model override (defaults to gpt-4o-mini)
# LLM_MODEL=gpt-4o-mini

# Optional custom base URL (e.g. for local Ollama: http://localhost:11434/v1)
# LLM_BASE_URL=https://api.openai.com/v1

# Optional override for whisper model path
# WHISPER_MODEL_PATH=/Users/username/.config/typeless/models/ggml-small.en.bin
